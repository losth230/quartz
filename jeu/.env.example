# ── Chasse & Pêche — configuration Supabase ─────────────────────────────
# Copiez ce fichier en `.env` et renseignez les valeurs de votre projet
# Supabase (https://supabase.com → Settings → API).
# Sans ces clés, l'application fonctionne en mode local (localStorage).

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
